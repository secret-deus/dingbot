# K8s MCP 简化配置
# 只需配置这两个核心字段即可

# Kubernetes配置文件路径
KUBECONFIG_PATH=

# 默认命名空间
K8S_NAMESPACE=

# 可选：服务器配置
K8S_MCP_HOST=localhost
K8S_MCP_PORT=8766
K8S_MCP_DEBUG=false

# ===== 资源告警配置 =====
# 启用资源告警功能（true/false）
RESOURCE_ALERT_ENABLED=true

# 告警阈值设置（0.0-1.0）
MEMORY_ALERT_THRESHOLD=0.7
CPU_ALERT_THRESHOLD=0.8

# 告警冷却时间（秒），防止频繁告警
ALERT_COOLDOWN_SECONDS=300

# ===== LLM智能分析配置 =====
# 启用LLM分析功能（true/false）
ENABLE_LLM_ANALYSIS=true

# LLM分析超时时间（秒）
LLM_ANALYSIS_TIMEOUT=30

# ===== 后端API通信配置 =====
# 后端API地址
BACKEND_API_URL=http://localhost:8000

# 启用后端通知（true/false）
ENABLE_BACKEND_NOTIFICATIONS=true

# API请求超时时间（秒）
API_TIMEOUT=30

# API请求最大重试次数
API_MAX_RETRIES=3

# ===== 指标聚合配置 =====
# 指标聚合间隔（秒），默认2周 = 1209600秒
METRICS_AGGREGATION_INTERVAL=1209600

# 指标分析天数
METRICS_ANALYSIS_DAYS=14

# Prometheus服务器地址（可选）
PROMETHEUS_URL=http://prometheus:9090 