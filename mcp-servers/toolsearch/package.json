    "test": "npm run build && node --test dist/src/*.test.js",
    "catalog:generate": "node scripts/generate-catalog.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "ip-address": "^10.2.0"
  },
  "engines": {
    "node": ">=20"
  }
}
