{
  "version": "1.0",
  "name": "MCP configuration example",
  "description": "K8s and ECS tools run in-process by default; no standalone MCP server is required.",
  "global_config": {
    "timeout": 600000,
    "retry_attempts": 3,
    "retry_delay": 1000,
    "max_concurrent_calls": 5,
    "enable_cache": true,
    "cache_timeout": 300000
  },
  "builtin": {
    "k8s": {
      "enabled": true,
      "kubeconfig_path": null,
      "namespace": "default",
      "in_cluster": false,
      "knowledge_graph_path": "backend-v2/data/k8s_knowledge_graph.json",
      "prometheus_base_url": null
    },
    "ecs": {
      "enabled": false,
      "access_key_id": null,
      "access_key_secret": null,
      "region_id": "cn-hangzhou"
    }
  },
  "servers": [
    {
      "name": "toolsearch",
      "type": "stdio",
      "implementation": "local",
      "enabled": false,
      "command": "node",
      "args": [
        "mcp-servers/toolsearch/dist/src/index.js"
      ],
      "cwd": ".",
      "env": {
        "TOOL_CATALOG_PATH": "config/tool_catalog.json"
      },
      "timeout": 60,
      "enabled_tools": [
        "toolsearch",
        "tool_get",
        "tool_categories",
        "tool_reload_catalog"
      ]
    }
  ],
  "tools": [],
  "tool_routing": {},
  "security": {
    "readonly_default": true,
    "audit_enabled": true
  },
  "logging": {
    "level": "INFO"
  }
}
