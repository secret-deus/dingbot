{
  "version": "1.0",
  "name": "LLM configuration example",
  "description": "Copy to config/llm_config.json and fill real provider credentials locally.",
  "enabled": true,
  "default_provider": "openai-compatible",
  "providers": [
    {
      "id": "openai-compatible",
      "name": "OpenAI compatible endpoint",
      "enabled": true,
      "model": "gpt-4o-mini",
      "api_key": "replace-with-local-secret",
      "base_url": "https://api.openai.com/v1",
      "temperature": 0.3,
      "max_tokens": 2000,
      "timeout": 60,
      "max_retries": 2,
      "stream": true,
      "supports_functions": true,
      "supports_vision": false,
      "supports_streaming": true
    }
  ],
  "global_defaults": {
    "temperature": 0.3,
    "max_tokens": 2000,
    "timeout": 60,
    "max_retries": 2,
    "stream": true
  },
  "security": {
    "enable_data_masking": true,
    "mask_sensitive_data": true,
    "allowed_hosts": [],
    "blocked_patterns": []
  },
  "logging": {
    "level": "INFO",
    "enable_request_logging": true,
    "enable_response_logging": false,
    "log_sensitive_data": false
  }
}
